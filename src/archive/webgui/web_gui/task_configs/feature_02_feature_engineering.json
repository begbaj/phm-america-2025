{
    "title": "Feature Engineering",
    "description": "Calculate statistical and physical features from sensor data.",
    "groups": [
        {
            "title": "📊 Configuration",
            "params": [
                {
                    "id": "target",
                    "label": "Target Variable",
                    "type": "select",
                    "options": ["HPC", "HPT", "WW"],
                    "default": "HPC"
                }
            ]
        },
        {
            "title": "📐 Rolling Window",
            "params": [
                {
                    "id": "pipeline_window",
                    "label": "Window Size",
                    "type": "number",
                    "default": 100
                },
                {
                    "id": "pipeline_step",
                    "label": "Step Size",
                    "type": "number",
                    "default": 25
                }
            ]
        },
        {
            "title": "📈 Statistical Features",
            "params": [
                {
                    "id": "statistical_features",
                    "label": "Select Features",
                    "type": "multiselect",
                    "options": ["mean", "rms", "std", "min", "max", "kurtosis", "skew"],
                    "default": ["mean", "rms"]
                }
            ]
        }
    ]
}