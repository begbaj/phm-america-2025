graph TD
    %% Nodi Principali
    Start([Start Project]) --> LoadData["Load Raw Data"]
    
    subgraph "1. Preprocessing Pipeline"
        LoadData --> MissingFill["Missing Value Imputation"]
        MissingFill --> OutlierRem["Outlier Removal (IsoForest)"]
        OutlierRem --> Smoothing["Smoothing (Rolling Mean/Median)"]
    end

    subgraph "2. Feature Engineering"
        Smoothing --> PhysFeat["Calculate Physical Features"]
        PhysFeat --> StatFeat["Calculate Statistical Features"]
        StatFeat --> CorrAnalysis["Correlation Analysis"]
    end

    subgraph "3. Model Training"
        CorrAnalysis --> Split["Train/Test Split"]
        Split --> TrainLR["Train Linear Regression"]
        Split --> TrainRF["Train Random Forest"]
        Split --> TrainXGB["Train XGBoost"]
        Split --> TrainTrans["Train Transformer"]
        TrainLR --> Evaluate["Evaluate Models (RMSE/Score)"]
        TrainRF --> Evaluate
        TrainXGB --> Evaluate
        TrainTrans --> Evaluate
    end

    subgraph "4. Residual & Health Analysis"
        Evaluate --> Baseline["Fit Baseline on Healthy Window"]
        Baseline --> CalcRes["Calculate Residuals (y - y_hat)"]
        CalcRes --> CalcHI["Calculate Health Index"]
        
        note1["HI = -alpha*T3 - T45"]
        CalcHI -.-> note1
        
        CalcHI --> OptimizeAlpha["Optimize Alpha (Max Correlation with Ref RUL)"]
        OptimizeAlpha --> FitMap["Fit Linear Mapping HI -> RUL"]
        FitMap --> CalcScore["Calculate TWE Score"]
        CalcScore --> GenPlots["Generate Plots"]
    end

    GenPlots --> End([End])

    %% Annotazioni Dati
    LoadData -.->|Raw CSV| MissingFill
    Smoothing -.->|Cleaned Data| PhysFeat
    PhysFeat -.->|Physical Params| StatFeat
    StatFeat -.->|Feature Matrix| Split
    CalcRes -.->|T3_res, T45_res| CalcHI