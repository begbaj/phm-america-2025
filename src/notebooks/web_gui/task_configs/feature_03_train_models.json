{
    "title": "Model Training",
    "description": "Train machine learning models on the engineered features.",
    "groups": [
        {
            "title": "🎯 Target & Baseline",
            "params": [
                {
                    "id": "target_training",
                    "label": "Target RUL",
                    "type": "select",
                    "options": ["HPC", "HPT", "WW"],
                    "default": "HPC"
                },
                {
                    "id": "healthy_window",
                    "label": "Healthy Window (Cycles)",
                    "type": "number",
                    "default": 100
                }
            ]
        },
        {
            "title": "🧠 Model Selection",
            "params": [
                {
                    "id": "models",
                    "label": "Models to Train",
                    "type": "multiselect",
                    "options": ["linear", "rf", "xgb", "transformer"],
                    "default": ["linear", "rf", "xgb"]
                }
            ]
        },
        {
            "title": "🌲 Random Forest Params",
            "params": [
                {
                    "id": "rf_n_estimators",
                    "label": "N Estimators",
                    "type": "number",
                    "default": 200
                },
                {
                    "id": "rf_max_depth",
                    "label": "Max Depth",
                    "type": "number",
                    "default": 15
                }
            ]
        },
        {
            "title": "🚀 XGBoost Params",
            "params": [
                {
                    "id": "xgb_n_estimators",
                    "label": "N Estimators",
                    "type": "number",
                    "default": 600
                },
                {
                    "id": "xgb_learning_rate",
                    "label": "Learning Rate",
                    "type": "number",
                    "step": 0.01,
                    "default": 0.05
                },
                {
                    "id": "xgb_max_depth",
                    "label": "Max Depth",
                    "type": "number",
                    "default": 6
                }
            ]
        },
        {
            "title": "🤖 Transformer Params",
            "params": [
                {
                    "id": "trans_epochs",
                    "label": "Epochs",
                    "type": "number",
                    "default": 400
                },
                {
                    "id": "trans_batch_size",
                    "label": "Batch Size",
                    "type": "number",
                    "default": 64
                },
                {
                    "id": "trans_learning_rate",
                    "label": "Learning Rate",
                    "type": "number",
                    "step": 0.0001,
                    "default": 0.001
                }
            ]
        }
    ]
}